<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. Compose draws all real UI; this just sets the splash/launch
         background and status bar before Compose takes over, and satisfies the manifest's
         android:theme requirement. -->
    <style name="Theme.PhotoAIStudio" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/purple_primary</item>
        <item name="android:windowBackground">@color/purple_primary</item>
    </style>
</resources>
